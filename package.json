{
  "name": "@console-one/sequence",
  "version": "0.2.0",
  "description": "A local engine for running many LLM agents against one governed tool surface \u2014 a type kernel where types, values, time, and belief are one continuum, with the ft language round-tripping the store.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/console-one/sequence.git"
  },
  "bugs": {
    "url": "https://github.com/console-one/sequence/issues"
  },
  "homepage": "https://github.com/console-one/sequence#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./dsl": {
      "types": "./dist/src/dsl/index.d.ts",
      "import": "./dist/src/dsl/index.js",
      "default": "./dist/src/dsl/index.js"
    },
    "./v2": {
      "types": "./dist/src-v2/index.d.ts",
      "import": "./dist/src-v2/index.js",
      "default": "./dist/src-v2/index.js"
    },
    "./v1": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "specs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "examples": "node examples/run-all.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm",
    "agents",
    "ai",
    "tool-use",
    "agent-tools",
    "type-system",
    "dsl",
    "local-first",
    "append-only",
    "behavioral-types",
    "incremental",
    "kernel",
    "ft",
    "sequence"
  ],
  "author": "zerotoprod",
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
